# Configuration SMTP pour l'envoi automatique d'emails (Complexe C'ESKY)
# Copiez ce fichier en .env.local et renseignez vos identifiants réels.

# Exemple avec Gmail (nécessite un "Mot de passe d'application" Google) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=complexecesky237@gmail.com
# SMTP_PASS=votre_mot_de_passe_application_16_caracteres
# SMTP_FROM="Complexe C’ESKY <complexecesky237@gmail.com>"

# Exemple avec un fournisseur SMTP transactionnel (Brevo / Sendgrid / etc.) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre_identifiant_brevo
# SMTP_PASS=votre_cle_smtp_brevo
# SMTP_FROM="Complexe C’ESKY <complexecesky237@gmail.com>"
